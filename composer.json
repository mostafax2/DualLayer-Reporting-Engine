{
    "name": "mostafax/dual-layer-reporting-engine",
    "description": "Dual-layer MySQL→MongoDB async reporting engine for Laravel",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "mongodb", "reporting", "sync", "analytics", "dual-layer"],
    "homepage": "https://packagist.org/packages/mostafax/dual-layer-reporting-engine",
    "authors": [{"name": "Mostafa", "email": "mostafa.m.elbiar2@gmail.com"}],
    "require": {
        "php": "^8.2",
        "illuminate/support":   "^10.0|^11.0|^12.0|^13.0",
        "illuminate/bus":       "^10.0|^11.0|^12.0|^13.0",
        "illuminate/queue":     "^10.0|^11.0|^12.0|^13.0",
        "illuminate/events":    "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database":  "^10.0|^11.0|^12.0|^13.0",
        "illuminate/cache":     "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "pestphp/pest": "^2.0"
    },
    "suggest": {
        "mongodb/laravel-mongodb": "Required for MongoDB target driver (^4.0)"
    },
    "autoload": {
        "psr-4": {"Mostafax\\DualLayer\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"Mostafax\\DualLayer\\Tests\\": "tests/"}
    },
    "extra": {
        "laravel": {
            "providers": ["Mostafax\\DualLayer\\DualLayerServiceProvider"],
            "aliases":   {"DualReport": "Mostafax\\DualLayer\\Support\\Facades\\DualReport"}
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
